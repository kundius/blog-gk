generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model File {
  id                String   @id @default(uuid()) @db.Uuid
  filenameDisk      String?  @map("filename_disk")
  filenameDownload  String   @map("filename_download")
  title             String?
  type              String?
  filesize          Int?
  width             Int?
  height            Int?
  description       String?
  blurhash          String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  articles       Article[]     @relation("ArticleThumbnail")
  albums         Album[]       @relation("AlbumThumbnail")
  albumGallery   AlbumFile[]
  categories     Category[]    @relation("CategoryThumbnail")
  collections    Collection[]  @relation("CollectionThumbnail")

  @@map("files")
}

model Category {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  content        String?
  alias          String  @unique
  parentId       String? @map("parent") @db.Uuid
  sort           Int?
  thumbnailId    String? @map("thumbnail") @db.Uuid
  seoTitle       String? @map("seo_title")
  seoKeywords    String? @map("seo_keywords")
  seoDescription String? @map("seo_description")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  thumbnail File? @relation("CategoryThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)

  articles          Article[]           @relation("ArticlePrimaryCategory")
  articleCategories ArticleCategory[]

  @@map("categories")
}

model Article {
  id            String   @id @default(uuid()) @db.Uuid
  status        String   @default("draft")
  dateCreated   DateTime? @map("date_created") @db.Timestamptz(6)
  dateUpdated   DateTime? @map("date_updated") @db.Timestamptz(6)
  alias         String?  @unique
  name          String
  content       String?
  oldContent    String? @map("old_content")
  excerpt       String?
  categoryId    String   @map("category") @db.Uuid
  thumbnailId   String?  @map("thumbnail") @db.Uuid
  ingredients   Json?
  portionCount  String?  @map("portion_count")
  cookingTime   String?  @map("cooking_time")
  calories      String?
  protein       String?
  fat           String?
  carbs         String?
  commentsCount Int      @default(0) @map("comments_count")
  hitsCount     Int      @default(0) @map("hits_count")
  likesCount    Int      @default(0) @map("likes_count")
  seoTitle      String?  @map("seo_title")
  seoKeywords   String?  @map("seo_keywords")
  seoDescription String? @map("seo_description")

  category  Category      @relation("ArticlePrimaryCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  thumbnail File?         @relation("ArticleThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
  categories ArticleCategory[]
  comments  Comment[]
  collections CollectionArticle[]
  related   ArticleRelated[] @relation("ArticleRelatedSource")
  relatedTo ArticleRelated[] @relation("ArticleRelatedTarget")

  @@map("articles")
}

model ArticleRelated {
  id               Int     @id @default(autoincrement())
  articleId        String? @map("article") @db.Uuid
  relatedArticleId String? @map("related_article") @db.Uuid
  sort             Int?

  article        Article? @relation("ArticleRelatedSource", fields: [articleId], references: [id], onDelete: Cascade)
  relatedArticle Article? @relation("ArticleRelatedTarget", fields: [relatedArticleId], references: [id], onDelete: Cascade)

  @@map("articles_related")
}

model ArticleCategory {
  id         Int     @id @default(autoincrement())
  articleId  String? @map("article") @db.Uuid
  categoryId String? @map("category") @db.Uuid
  sort       Int?

  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("articles_categories")
}

model Album {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  alias          String  @unique
  thumbnailId    String? @map("thumbnail") @db.Uuid
  seoTitle       String? @map("seo_title")
  seoKeywords    String? @map("seo_keywords")
  seoDescription String? @map("seo_description")

  thumbnail File?       @relation("AlbumThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
  photos    AlbumFile[]

  @@map("albums")
}

model AlbumFile {
  id      Int     @id @default(autoincrement())
  albumId String? @map("album") @db.Uuid
  fileId  String? @map("file") @db.Uuid
  sort    Int?

  album Album? @relation(fields: [albumId], references: [id], onDelete: Cascade)
  file  File?  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("albums_files")
}

model Collection {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  alias          String   @unique
  description    String?
  thumbnailId    String?  @map("thumbnail") @db.Uuid
  showOnHome     Boolean  @default(false) @map("show_on_home")
  seoTitle       String?  @map("seo_title")
  seoKeywords    String?  @map("seo_keywords")
  seoDescription String?  @map("seo_description")
  dateCreated    DateTime @default(now()) @map("date_created") @db.Timestamptz(6)
  dateUpdated    DateTime? @map("date_updated") @db.Timestamptz(6)

  thumbnail File?               @relation("CollectionThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
  articles  CollectionArticle[]

  @@map("collections")
}

model CollectionArticle {
  id           Int     @id @default(autoincrement())
  collectionId String? @map("collection") @db.Uuid
  articleId    String? @map("article") @db.Uuid
  sort         Int?

  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  article    Article?    @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("collections_articles")
}

model Comment {
  id          String   @id @default(uuid()) @db.Uuid
  status      String   @default("pending")
  dateCreated DateTime? @map("date_created") @db.Timestamptz(6)
  dateUpdated DateTime? @map("date_updated") @db.Timestamptz(6)
  content     String?
  raw         String?
  authorName  String?  @map("author_name")
  authorEmail String?  @map("author_email")
  parentId    String?  @map("parent") @db.Uuid
  articleId   String?  @map("article") @db.Uuid

  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies Comment[] @relation("CommentReplies")
  article Article?  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Subscriber {
  id          String    @id @default(uuid()) @db.Uuid
  dateCreated DateTime? @map("date_created") @db.Timestamptz(6)
  email       String    @unique

  @@map("subscribers")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         String    @default("user")
  status       String    @default("active")
  dateCreated  DateTime? @map("date_created") @db.Timestamptz(6)
  dateUpdated  DateTime? @map("date_updated") @db.Timestamptz(6)

  @@map("users")
}
