# Шаблон для ПРОДА (pm2). Скопируй в .env на сервере и заполни.
# Пароль с спецсимволами (@, #, % и т.д.) нужно URL-кодировать:
# @ → %40, # → %23, % → %25, / → %2F, ? → %3F
# Если PostgreSQL на том же хосте, что и приложение — используй localhost.
DATABASE_URL=postgresql://blog_gk_user:blog_gk_password@localhost:5432/blog_gk_db
PORT=4000

# CORS: * или список источников через запятую
CORS_ORIGIN=https://blog-gk.ru

# JWT-авторизация админки. Сгенерируй длинную случайную строку (например: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# S3 (AWS / MinIO / Yandex Object Storage и др. совместимые)
# Доступы к S3 будут добавлены позже. Без них загрузка файлов не работает.
S3_ENDPOINT=
S3_REGION=ru-1a
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
