# Шаблон для ПРОДА (pm2). Скопируй в .env на сервере и заполни.
# NEXT_PUBLIC_* — подставляются в клиентский бандл на этапе сборки.
# NEXT_PUBLIC_CLIENT_URL — публичный адрес сайта
NEXT_PUBLIC_CLIENT_URL=https://blog-gk.ru
# NEXT_PUBLIC_API_URL — адрес API, доступный и браузеру, и серверу сайта
# (в docker-compose через network_mode gateway это http://localhost:4040)
NEXT_PUBLIC_API_URL=https://api.blog-gk.ru
# IMAGE_DOMAINS — хосты, с которых Next.js загружает изображения (через запятую)
IMAGE_DOMAINS=blog-gk.ru,api.blog-gk.ru

# S3 (прямой доступ к файлам, стримим с site минуя backend)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
