# Шаблон для ПРОДА (pm2). Скопируй в .env на сервере и заполни.
# CLIENT_URL — публичный адрес сайта
CLIENT_URL=https://blog-gk.ru
# API_URL — публичный адрес API (NestJS)
API_URL=https://api.blog-gk.ru
# GRAPHQL_URL — больше не используется новым бекендом (REST), оставь для совместимости
GRAPHQL_URL=https://api.blog-gk.ru/graphql
# SECRET — замени на случайное значение
SECRET=change-me
# IMAGE_DOMAINS — хосты, с которых Next.js загружает изображения (через запятую)
IMAGE_DOMAINS=blog-gk.ru,api.blog-gk.ru
