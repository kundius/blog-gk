# Шаблон: cp .env.example .env
# Значения для docker compose (env_file сервисов postgres и pgadmin).
# Приложения (backend/site) читают свои .env: backend/.env и site/.env.

POSTGRES_USER=blog_gk_user
POSTGRES_PASSWORD=blog_gk_password
POSTGRES_DB=blog_gk_db

PGADMIN_DEFAULT_EMAIL=admin@blog-gk.dev
PGADMIN_DEFAULT_PASSWORD=blog_gk_password
